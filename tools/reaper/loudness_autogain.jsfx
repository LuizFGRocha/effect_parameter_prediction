desc: loudness autogain (POC II)
// Leva o sinal a uma loudness alvo (padrao -26 LUFS), como o render do POC II faz
// antes e depois de cada plugin. Use um antes do plugin e outro depois.
//
// O render aplica UM ganho fixo por trecho de 2 s. Aqui o ganho acompanha a
// loudness de uma janela deslizante e muda devagar, para nao virar compressor:
// um ganho rapido mudaria a dinamica que entra na distorcao. Depois de o ganho
// assentar, `Congelar` o trava -- e o mais proximo do ganho fixo do render.
//
// Loudness como a do pyloudnorm (BS.1770): ponderacao K com os mesmos biquads
// (RBJ; high shelf +4 dB em 1500 Hz, Q 0,707; passa-altas em 38 Hz, Q 0,5) e
// -0,691 + 10 log10(media quadratica). Os dois canais entram pela MEDIA, nao pela
// soma: uma guitarra mono duplicada no estereo mede o mesmo que o arquivo mono do
// render, em vez de 3 dB a mais.

slider1:target=-26<-40,-10,0.1>Alvo (LUFS)
slider2:window_s=3<0.4,10,0.1>Janela (s)
slider3:smooth_s=0.5<0.05,5,0.05>Suavizacao do ganho (s)
slider4:freeze=0<0,1,1{Nao,Sim}>Congelar ganho
slider5:gate=-60<-80,-30,1>Abaixo disto, nao mexe (LUFS)
slider6:max_gain=30<0,60,1>Ganho maximo (+- dB)

@init
function biquad_shelf(G, fc, Q) local(A, w0, cw, al, a0) (
  A = 10 ^ (G / 40); w0 = 2 * $pi * fc / srate; cw = cos(w0); al = sin(w0) / (2 * Q);
  a0 = (A + 1) - (A - 1) * cw + 2 * sqrt(A) * al;
  s_b0 = A * ((A + 1) + (A - 1) * cw + 2 * sqrt(A) * al) / a0;
  s_b1 = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
  s_b2 = A * ((A + 1) + (A - 1) * cw - 2 * sqrt(A) * al) / a0;
  s_a1 = 2 * ((A - 1) - (A + 1) * cw) / a0;
  s_a2 = ((A + 1) - (A - 1) * cw - 2 * sqrt(A) * al) / a0;
);
function biquad_highpass(fc, Q) local(w0, cw, al, a0) (
  w0 = 2 * $pi * fc / srate; cw = cos(w0); al = sin(w0) / (2 * Q);
  a0 = 1 + al;
  h_b0 = (1 + cw) / 2 / a0; h_b1 = -(1 + cw) / a0; h_b2 = (1 + cw) / 2 / a0;
  h_a1 = -2 * cw / a0; h_a2 = (1 - al) / a0;
);
biquad_shelf(4, 1500, sqrt(0.5));
biquad_highpass(38, 0.5);


// Janela deslizante em blocos de 100 ms, como os blocos do BS.1770.
block_len = floor(0.1 * srate);
blocks = 0;        // buffer circular de energias medias por bloco, a partir de 0
max_blocks = 100;  // ate 10 s
block_acc = 0; block_n = 0; block_i = 0; filled = 0;
gain_db = 0; goal_db = 0; gain = 1;

@slider
n_blocks = max(1, min(max_blocks, floor(window_s * 10 + 0.5)));
coef = exp(-1 / (smooth_s * srate));

@sample
// Ponderacao K dos dois canais.
k0 = s_b0 * spl0 + s_b1 * s0x1 + s_b2 * s0x2 - s_a1 * s0y1 - s_a2 * s0y2;
s0x2 = s0x1; s0x1 = spl0; s0y2 = s0y1; s0y1 = k0;
w0_ = h_b0 * k0 + h_b1 * h0x1 + h_b2 * h0x2 - h_a1 * h0y1 - h_a2 * h0y2;
h0x2 = h0x1; h0x1 = k0; h0y2 = h0y1; h0y1 = w0_;

k1 = s_b0 * spl1 + s_b1 * s1x1 + s_b2 * s1x2 - s_a1 * s1y1 - s_a2 * s1y2;
s1x2 = s1x1; s1x1 = spl1; s1y2 = s1y1; s1y1 = k1;
w1_ = h_b0 * k1 + h_b1 * h1x1 + h_b2 * h1x2 - h_a1 * h1y1 - h_a2 * h1y2;
h1x2 = h1x1; h1x1 = k1; h1y2 = h1y1; h1y1 = w1_;

block_acc += (w0_ * w0_ + w1_ * w1_) / 2;
block_n += 1;

block_n >= block_len ? (
  blocks[block_i] = block_acc / block_n;
  block_i = (block_i + 1) % max_blocks;
  filled = min(filled + 1, max_blocks);
  block_acc = 0; block_n = 0;

  // Media dos ultimos `n_blocks` blocos.
  used = min(filled, n_blocks);
  total = 0; j = 0;
  loop(used,
    total += blocks[(block_i - 1 - j + max_blocks) % max_blocks];
    j += 1;
  );
  // Medida na ENTRADA, antes do ganho: sem realimentacao, o ganho certo e
  // simplesmente alvo - medida.
  loudness = -0.691 + 10 * log10(max(total / used, 1e-20));
  !freeze && loudness > gate ? (
    goal_db = max(-max_gain, min(max_gain, target - loudness));
  );
);

!freeze ? gain_db = coef * gain_db + (1 - coef) * goal_db;
gain = 10 ^ (gain_db / 20);
spl0 *= gain;
spl1 *= gain;
